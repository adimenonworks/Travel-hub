rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function tripData(tripId) { return get(/databases/$(database)/documents/trips/$(tripId)).data; }
    function isMember(tripId) { return signedIn() && uid() in tripData(tripId).memberIds; }
    // A Planner: everyone on the trip but a Viewer ('owner', 'editor' and 'member' are stored; they plan alike)
    function isManager(tripId) { return signedIn() && tripData(tripId).roles[uid()] in ['owner', 'editor', 'member']; }
    // A shared collection (collectionShares/{ownerId}_{countryCode}): your role in it ('owner', 'member', 'viewer' or '')
    function shareDoc(id) { return /databases/$(database)/documents/collectionShares/$(id); }
    function shareRole(id) {
      return id is string && id != '' && exists(shareDoc(id))
        ? (get(shareDoc(id)).data.ownerId == uid() ? 'owner' : get(shareDoc(id)).data.roles.get(uid(), ''))
        : '';
    }
    // A Viewer sees the trip and chats, but adds, edits and votes on nothing
    function isContributor(tripId) { return isMember(tripId) && tripData(tripId).roles[uid()] != 'viewer'; }

    // Public profile: just name and photo, so trip-mates can see who's who.
    // It can be fetched by id but never listed, so nobody can browse all users.
    match /users/{userId} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['name', 'photo']);
      allow delete: if signedIn() && uid() == userId;

      // Private profile: home city and visited places. Only the owner can see it.
      match /private/{docId} {
        allow read, write: if signedIn() && uid() == userId;
      }
    }

    match /trips/{tripId} {
      allow read: if signedIn() && uid() in resource.data.memberIds;

      // Optional cover photo: a small JPEG/WebP stored as text, under 500 KB.
      function validCover(d) {
        return !('coverPhoto' in d) || d.coverPhoto == null
          || (d.coverPhoto is string && d.coverPhoto.size() < 500000
              && d.coverPhoto.matches('^data:image/(jpeg|webp);base64,[A-Za-z0-9+/=]+$'));
      }

      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && request.resource.data.memberIds == [uid()]
        && request.resource.data.roles == { (uid()): 'owner' }
        && validCover(request.resource.data);

      // Planners edit anything except ownership, and can't drop whoever created the trip (only they delete it).
      function managerUpdate() {
        return resource.data.roles[uid()] in ['owner', 'editor', 'member']
          && request.resource.data.ownerId == resource.data.ownerId
          && resource.data.ownerId in request.resource.data.memberIds
          && request.resource.data.roles[resource.data.ownerId] == 'owner'
          && validCover(request.resource.data)
          && binOk();
      }
      // Recently deleted: only whoever created the trip moves it there; any Planner brings it back
      function binOk() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['deletedAt', 'deletedBy'])
          || resource.data.ownerId == uid()
          || !('deletedAt' in request.resource.data);
      }

      // A non-member joins with a valid, unexpired invite for this trip.
      function joining() {
        let invite = get(/databases/$(database)/documents/invites/$(request.resource.data.joinedVia));
        return !(uid() in resource.data.memberIds)
          && invite.data.tripId == tripId
          && invite.data.expiresAt > request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'roles', 'joinedVia'])
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([uid()].toSet())
          && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([uid()])
          && request.resource.data.roles[uid()] == 'member';
      }

      // A member (not the owner) removes only themselves.
      function leaving() {
        return uid() in resource.data.memberIds
          && uid() != resource.data.ownerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'roles'])
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().difference([uid()].toSet())
          && !(uid() in request.resource.data.roles);
      }

      // The owner deleting their account hands the trip to another member and leaves, in one change.
      function handingOver() {
        let to = request.resource.data.ownerId;
        return resource.data.ownerId == uid()
          && to != uid() && to in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'memberIds', 'roles'])
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().difference([uid()].toSet())
          && request.resource.data.roles[to] == 'owner'
          && !(uid() in request.resource.data.roles)
          && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([uid(), to]);
      }

      allow update: if signedIn() && (managerUpdate() || joining() || leaving() || handingOver());
      allow delete: if signedIn() && resource.data.ownerId == uid();

      // Activities, ideas, albums, comments (and old expenses): members only.
      // Anyone on the trip but a Viewer can add and update (votes, who's going); Viewers can only comment. Only the
      // person who added something, or an
      // owner/organiser, can delete it; comments can only be edited or deleted by their author. Text has size limits:
      // comments 150 characters, titles 200, notes 2,000 (so nobody can store huge documents everyone has to load).
      match /{sub}/{docId} {
        function d() { return request.resource.data; }
        function shortText(f, n) { return !(f in d()) || d()[f] == null || (d()[f] is string && d()[f].size() <= n); }
        function sizesOk() { return shortText('title', 200) && shortText('notes', 2000) && shortText('text', 150) && shortText('locationText', 300); }
        function addedByMe() { return resource.data.get('createdBy', '') == uid() || resource.data.get('authorId', '') == uid(); }
        function noAuthor() { return !('createdBy' in resource.data) && !('authorId' in resource.data); }

        allow read: if isMember(tripId);
        allow create: if isMember(tripId) && sizesOk()
          && (sub == 'comments' || isContributor(tripId))
          && d().get('createdBy', uid()) == uid()
          && (sub != 'comments' || (d().authorId == uid() && d().text is string && d().text.size() > 0));
        allow update: if isMember(tripId) && sizesOk()
          && (sub == 'comments' || isContributor(tripId))
          && d().get('createdBy', '') == resource.data.get('createdBy', '')
          && (sub != 'comments' || addedByMe());
        allow delete: if isMember(tripId) && (addedByMe() || noAuthor() || (sub != 'comments' && isManager(tripId)));
      }
    }

    // Saved Places (Collections). Each belongs to the person who saved it. Anyone signed in can read one by id
    // (trip-mates see a Place added to their trip's ideas). A list returns your own Places, the ones you've starred,
    // and the ones in a collection shared with you: added to it (`sharedIn`), or its owner's own Places in that country.
    // Only whoever saved it deletes it; in a shared collection its owner or a Member may also move it (city) or change its category; anyone may add or remove their own star.
    match /places/{placeId} {
      function stars(d) { return d.get('starredBy', []); }
      allow get: if signedIn();
      function sharedIn(d) { return d.get('sharedIn', ''); }
      // The collection a Place is in: the one it was added to (`sharedIn`), else its owner's own for its country
      function inShare(d) { return sharedIn(d) != '' ? sharedIn(d) : d.ownerId + '_' + d.get('countryCode', ''); }
      allow list: if signedIn() && (resource.data.ownerId == uid() || uid() in stars(resource.data)
        || shareRole(inShare(resource.data)) in ['owner', 'member', 'viewer']);
      // Into a shared collection only as its owner or a Member
      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && stars(request.resource.data).toSet().difference([uid()].toSet()).size() == 0
        && (sharedIn(request.resource.data) == '' || shareRole(sharedIn(request.resource.data)) in ['owner', 'member']);
      // When its owner deletes their account, a Place a trip still uses goes to someone on that trip (handedVia).
      function handedOver() {
        let trip = get(/databases/$(database)/documents/trips/$(request.resource.data.handedVia)).data;
        return uid() in trip.memberIds && request.resource.data.ownerId in trip.memberIds;
      }
      // A changed `sharedIn` must be a collection you own or are a Member of
      function sharedInOk() {
        return sharedIn(request.resource.data) == sharedIn(resource.data) || sharedIn(request.resource.data) == ''
          || shareRole(sharedIn(request.resource.data)) in ['owner', 'member'];
      }
      allow update: if signedIn() && (
        (resource.data.ownerId == uid() && (request.resource.data.ownerId == resource.data.ownerId || handedOver()) && sharedInOk())
        || (shareRole(inShare(resource.data)) in ['owner', 'member']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['category', 'city', 'starredBy'])
            && stars(request.resource.data).toSet().difference(stars(resource.data).toSet())
                 .union(stars(resource.data).toSet().difference(stars(request.resource.data).toSet())).hasOnly([uid()]))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['starredBy'])
            && stars(request.resource.data).toSet().difference(stars(resource.data).toSet())
                 .union(stars(resource.data).toSet().difference(stars(request.resource.data).toSet())).hasOnly([uid()])));
      allow delete: if signedIn() && resource.data.ownerId == uid();
    }

    // A shared collection: its owner manages who's in it and their role; you join with a valid collection invite (as the
    // invite's role) and can leave. Only the owner and the people in it can read it.
    match /collectionShares/{shareId} {
      allow get, list: if signedIn() && (resource.data.ownerId == uid() || uid() in resource.data.memberIds);
      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && shareId == uid() + '_' + request.resource.data.countryCode
        && request.resource.data.memberIds.size() == 0;
      function ownerChange() {
        return resource.data.ownerId == uid()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'roles']);
      }
      function joiningShare() {
        let invite = get(/databases/$(database)/documents/invites/$(request.resource.data.joinedVia)).data;
        return !(uid() in resource.data.memberIds)
          && invite.get('kind', 'trip') == 'collection'
          && invite.shareId == shareId
          && invite.expiresAt > request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'roles', 'joinedVia'])
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().union([uid()].toSet())
          && request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([uid()])
          && request.resource.data.roles[uid()] == invite.role;
      }
      function leavingShare() {
        return uid() in resource.data.memberIds
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'roles'])
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().difference([uid()].toSet())
          && !(uid() in request.resource.data.roles);
      }
      allow update: if signedIn() && (ownerChange() || joiningShare() || leavingShare());
      allow delete: if signedIn() && resource.data.ownerId == uid();
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      // A trip invite by its owner or an organiser; a collection invite by the collection's owner, as Member or Viewer
      allow create: if signedIn()
        && request.resource.data.createdBy == uid()
        && (request.resource.data.get('kind', 'trip') == 'collection'
            ? (shareRole(request.resource.data.shareId) == 'owner' && request.resource.data.role in ['member', 'viewer'])
            : isManager(request.resource.data.tripId));
      allow delete: if signedIn() && resource.data.createdBy == uid();
    }
  }
}
